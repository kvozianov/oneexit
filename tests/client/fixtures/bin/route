#!/usr/bin/env bash
# Test stub for route: "route -n get default" answers 192.168.1.1 on en0.
if [ "$*" = "-n get default" ]; then
  printf '%s\n' "   route to: default" "destination: default" "       mask: default" \
    "    gateway: 192.168.1.1" "  interface: en0"
  exit 0
fi
echo "route: writing to routing socket: not in table" >&2
exit 1
